<Application x:Class="MapDataManager.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#101722" />
        <SolidColorBrush x:Key="PanelBackground" Color="#172131" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#2A3A50" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F6FA" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA9BC" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#24344A" />
            <Setter Property="Foreground" Value="#F3F6FA" />
            <Setter Property="BorderBrush" Value="#3A506C" />
        </Style>
    </Application.Resources>
</Application>
