<Window x:Class="MapDataManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="Map Data Manager — Windows GIS" Width="1400" Height="850" WindowStartupLocation="CenterScreen">
    <Grid Background="#111827">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B1220" Padding="18">
            <StackPanel>
                <TextBlock Text="MAP DATA MANAGER" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Windows Native GIS" Foreground="#94A3B8" Margin="0,5,0,30"/>
                <Button Content="Offline Map" Height="42" Margin="0,0,0,10" Click="OfflineMap_Click"/>
                <Button Content="Online Map" Height="42" Margin="0,0,0,10" Click="OnlineMap_Click"/>
                <Button Content="Map Data" Height="42" Margin="0,0,0,10" Click="MapData_Click"/>
                <Button Content="Settings" Height="42"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="PageTitle" Text="Offline Map" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="Native GIS engine ready." Foreground="#94A3B8" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBox x:Name="SearchBox" Width="310" Height="36" Padding="10,7" Margin="0,0,8,0"
                             ToolTip="Search city/place or latitude, longitude" KeyDown="PMTilesSearchBox_KeyDown"/>
                    <Button Content="SEARCH" Width="90" Height="36" Margin="0,0,8,0" Click="PMTilesSearch_Click"/>
                    <Button Content="GO TO" Width="75" Height="36" Margin="0,0,8,0" Click="PMTilesGoTo_Click" ToolTip="Go to the latitude, longitude entered in the search box"/>
                    <Button Content="DOWNLOAD" Width="105" Height="36" Margin="0,0,8,0" Click="Download_Click"/>
                    <Button x:Name="FolderButton" Content="Select Map Folder" Padding="18,8" Margin="0,0,8,0" Click="SelectFolder_Click"/>
                    <Button Content="Open PMTiles" Padding="18,8" Click="SelectPMTiles_Click" ToolTip="Open a local PMTiles raster archive"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <mapsui:MapControl x:Name="MapControl" Visibility="Visible" MapPointerMoved="MapControl_MapPointerMoved"/>
                    <ScrollViewer x:Name="OfflineScrollViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MouseMove="OfflineMap_MouseMove">
                        <Canvas x:Name="OfflineCanvas" Background="#1E293B"/>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15" Width="48">
                        <Button x:Name="ZoomInButton" Content="+" FontSize="25" FontWeight="Bold" Height="45" Margin="0,0,0,5" Click="PMTilesZoomIn_Click" ToolTip="Zoom in"/>
                        <Button x:Name="ZoomOutButton" Content="−" FontSize="25" FontWeight="Bold" Height="45" Margin="0,0,0,5" Click="PMTilesZoomOut_Click" ToolTip="Zoom out"/>
                        <Button x:Name="ZoomHomeButton" Content="⌂" FontSize="20" Height="42" Click="PMTilesZoomHome_Click" ToolTip="Pakistan / default view"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15" Padding="12" Background="#DD0B1220" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="GIS STATUS" Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="CoverageText" Text="No offline dataset loaded" Foreground="#CBD5E1" Margin="0,5,0,0"/>
                            <TextBlock Text="PMTiles raster support + English place labels" Foreground="#94A3B8" Margin="0,4,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Phase1Highlight" Visibility="Collapsed" Width="190" Height="72"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#DD0B1220" BorderBrush="#38BDF8" BorderThickness="2"
                            CornerRadius="36" IsHitTestVisible="False" Padding="10">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Phase1MarkerTitle" Text="SEARCH RESULT" Foreground="#7DD3FC" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="Phase1MarkerCoordinates" Text="33.684400, 73.047900" Foreground="White" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15" Padding="10,7" Background="#EE0B1220" CornerRadius="5">
                        <TextBlock x:Name="MouseCoordinateText" Text="Cursor: Lat ---, Lon ---" Foreground="White" FontFamily="Consolas" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <StatusBar Grid.Row="2" Margin="0,10,0,0">
                <StatusBarItem Content="Native WPF GIS"/>
                <Separator/>
                <StatusBarItem x:Name="FileStatus" Content="No folder selected"/>
                <Separator/>
                <StatusBarItem x:Name="ModeStatus" Content="OFFLINE"/>
                <Separator/>
                <StatusBarItem x:Name="CoordinateStatus" Content="Lat ---, Lon ---"/>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
