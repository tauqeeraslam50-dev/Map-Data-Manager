<Window x:Class="MapDataManager.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Online Map for Offline Use" Width="520" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Download Map for Offline Use" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="Download OpenStreetMap XYZ tiles. Keep the area and zoom range reasonable for offline storage." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Preset"/>
                <ComboBox x:Name="PresetBox" SelectedIndex="0" SelectionChanged="PresetBox_SelectionChanged">
                    <ComboBoxItem Content="Pakistan"/>
                    <ComboBoxItem Content="Islamabad / Rawalpindi"/>
                    <ComboBoxItem Content="Lahore"/>
                    <ComboBoxItem Content="Karachi"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Dataset name"/>
                <TextBox x:Name="DatasetBox" Text="Pakistan-OSM"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="West"/><TextBox x:Name="WestBox"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="East"/><TextBox x:Name="EastBox"/></StackPanel>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="South"/><TextBox x:Name="SouthBox"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="North"/><TextBox x:Name="NorthBox"/></StackPanel>
        </Grid>
        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Minimum zoom"/><ComboBox x:Name="MinZoomBox" SelectedIndex="5"><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Maximum zoom"/><ComboBox x:Name="MaxZoomBox" SelectedIndex="7"><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/><ComboBoxItem Content="13"/><ComboBoxItem Content="14"/></ComboBox></StackPanel>
        </Grid>

        <TextBlock Grid.Row="6" x:Name="EstimateText" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
        <TextBlock Grid.Row="7" Text="Downloaded data is stored as standard XYZ tiles (zoom/x/y.png), so it can be loaded later with Select Map Folder and used without Internet." Foreground="#64748B" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="90" Height="34" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Download" Width="100" Height="34" IsDefault="True" Click="Download_Click"/>
        </StackPanel>
    </Grid>
</Window>
